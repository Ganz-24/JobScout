# Optional API keys. Copy this file to `.env`, fill in what you have, and restart.
# Without any keys, JobScout still searches 11 free sources.

# Anthropic API key — enables AI resume suggestions, auto-tailoring and cover letters
# in the Resume tab (uses Claude Opus 5.5). Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# JSearch on RapidAPI: aggregates LinkedIn, Indeed, Glassdoor, ZipRecruiter (free tier available)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Free plan = 200 requests/month; each page (10 jobs) per position costs 1. Results are cached 6h.
JSEARCH_PAGES=1
# Optional country code for JSearch (default us)
JSEARCH_COUNTRY=

# Adzuna (free developer key): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code: us, gb, ca, au, de, fr, in, ...
ADZUNA_COUNTRY=us

# USAJOBS (US federal jobs, free): https://developer.usajobs.gov/apirequest/
USAJOBS_KEY=
USAJOBS_EMAIL=

# PORT=3000
